\contentsline {section}{\numberline {1}考点1:相关性基础}{2}{section.1}%
\contentsline {subsection}{题号1考察: 掌握相关性互换的支付计算：计算实现相关性，支付 = 名义金额 × (实现相关性 - 固定相关性) }{2}{Item.4}%
\contentsline {subsection}{题号2考察: 掌握风险分析的关键：考虑风险因子之间的相互作用，因为风险不是独立的，相互作用可能放大或减少总风险 }{3}{Item.8}%
\contentsline {subsection}{题号3考察: 掌握Copula的特点：从联合分布中提取依赖结构，可以建模非线性依赖和尾部依赖，比相关性更灵活 }{4}{Item.12}%
\contentsline {subsection}{题号4考察: 掌握流动性风险类型：内生流动性风险对复杂交易头寸最麻烦，因为它源于头寸本身，随规模增加，难以预测 }{5}{Item.16}%
\contentsline {subsection}{题号5考察: 掌握CDO分层交易策略：做多权益层和做空中间层的组合，相关性下降会导致双重损失 }{6}{Item.20}%
\contentsline {subsection}{题号6考察: 掌握联合违约概率计算：考虑违约概率和违约相关性，计算最坏情况下的预期损失 }{7}{Item.24}%
\contentsline {subsection}{题号7考察: 掌握Copula模型失败原因：假设负相关、使用低风险数据校准、危机期间相关性增加，但优先层相关性也增加而非减少 }{8}{Item.28}%
\contentsline {subsection}{题号8考察: 掌握ES和VaR的区别：ES需要更多资本，具有次可加性，考虑尾部损失严重程度，但回测更困难 }{9}{Item.32}%
\contentsline {subsection}{题号9考察: 掌握动态相关性度量：配对交易是动态相关性的例子，因为它实时监控相关性变化并调整策略 }{10}{Item.36}%
\contentsline {subsection}{题号10考察: 掌握期权组合VaR的计算：使用delta-normal方法，考虑深度实值期权delta≈1，深度虚值期权delta≈0，远期delta=1 }{10}{Item.40}%
\contentsline {subsection}{题号11考察: 掌握违约概率特征：非投资级债券短期违约风险高，随时间推移风险降低，投资级债券违约风险随期限增加 }{11}{Item.44}%
\contentsline {subsection}{题号12考察: 掌握依赖结构特征：相关性只对特定分布有效，零相关不意味着独立，Copula可分别建模边际和依赖结构，短期相关性估计不稳定 }{12}{Item.48}%
\contentsline {subsection}{题号13考察: 掌握VaR计算和解释：VaR(2.5\%)表示有2.5\%的概率损失超过该金额，计算使用z值乘以标准差再乘以组合价值 }{13}{Item.52}%
\contentsline {subsection}{题号14考察: 掌握Copula和相关性：资产收益的依赖关系对风险度量至关重要，Pearson相关性是线性度量，Copula允许更一般的依赖结构 }{15}{Item.56}%
\contentsline {subsection}{题号15考察: 掌握风险度量的一致性：单调性表示收益更高的组合风险更低，这是风险度量的基本性质 }{16}{Item.60}%
\contentsline {subsection}{题号16考察: 掌握相关性互换计算：平均实现相关性是所有配对相关性的算术平均值，用于计算互换支付 }{17}{Item.64}%
\contentsline {subsection}{题号17考察: 掌握互换交易策略：波动率互换支付方在波动率上升时获利，相关性互换多头在实现相关性高于固定相关性时获利 }{18}{Item.68}%
\contentsline {section}{\numberline {2}考点2:相关性的经验特性}{19}{section.2}%
\contentsline {subsection}{题号1考察: 理解相关性均值回归：当前相关性会向长期均值回归 }{19}{Item.72}%
\contentsline {subsection}{题号2考察: 理解经济周期对相关性的影响：衰退期相关性高，正常期波动大 }{20}{Item.76}%
\contentsline {subsection}{题号3考察: 理解均值回归：变量会以一定速率向长期均值回归 }{20}{Item.80}%
\contentsline {subsection}{题号4考察: 掌握相关性分布：股权和违约用Johnson SB，债券用极值分布 }{21}{Item.84}%
\contentsline {subsection}{题号5考察: 理解相关性均值回归：当前值会以一定速率向长期均值回归 }{21}{Item.88}%
\contentsline {section}{\numberline {3}考点3:财务相关性建模}{22}{section.3}%
\contentsline {subsection}{题号1考察: 理解Copula函数：边际分布不一定是标准正态分布 }{22}{Item.92}%
\contentsline {subsection}{题号2考察: 掌握相关性分布：股指和信用用Johnson SB，商品用极值分布 }{23}{Item.96}%
\contentsline {subsection}{题号3考察: 理解Student's t copula：将边际分布映射到标准t分布 }{23}{Item.100}%
\contentsline {subsection}{题号4考察: 理解Copula和相关性：Copula可独立建模依赖结构，相关性要求有限方差 }{24}{Item.104}%
\contentsline {subsection}{题号5考察: }{24}{Item.108}%
\contentsline {subsection}{题号6考察: 理解Sklar定理：联合分布可通过copula和边际分布表示 }{25}{Item.112}%
\contentsfinish 
