\@writefile{toc}{\contentsline {section}{\numberline {1}考点1:Overview of Risk Management 风险管理概况}{4}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号1考察: 投资者在风险管理中对意外损失的关注程度及其对风险管理过程的理解。（特别是要理解风险管理是零和游戏）}{4}{Item.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号2考察: 风险管理过程中的识别、分析和管理风险的活动。（风险管理就是去平衡增量收益和增量风险，而不是消除风险）}{5}{Item.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号3考察: 理解风险管理在经济层面上的效果。（风险管理在经济层面上的效果有限，因为它主要涉及风险的转移，而不是消除风险。）}{6}{Item.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号4考察: 理解风险管理与风险承担的区别。（风险管理是控制和缓解风险，风险承担是接受风险以实现潜在收益）}{6}{Item.16}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号5考察: 理解风险管理过程中存在的问题。（风险管理过程中存在的问题主要是两个方面的。一是难以正确地识别风险,二是难以寻求到有效的风险转移的方法。）}{7}{Item.20}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号6考察: 理解风险管理在经济层面上的效果。（个别企业的风险管理策略可能对整个经济系统产生显著影响。）}{8}{Item.24}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号7考察: 理解金融危机期间风险管理失败的原因。（风险管理在整体经济上并不总是有效）}{8}{Item.28}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}考点2：风险管理基础的十个block}{9}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号1考察: 理解风险识别的方法。（风险识别的方法有：头脑风暴、损失数据分析、场景分析）}{9}{Item.32}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号2考察: 理解风险管理的风险-收益关系。（风险管理需要在风险和收益之间找到平衡点）}{10}{Item.36}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号3考察: 理解不同类型风险的基本概念。（预期损失是可以通过历史数据预测的，而意外损失和Knightian不确定性都具有不可预测性）}{11}{Item.40}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号4考察: 理解风险-收益关系的复杂性。（一般情况是风险和收益正相关）}{11}{Item.44}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号5考察: 对不同类型风险的识别和理解。（违约风险与结算风险别混淆了，同时留意非线性风险）}{12}{Item.48}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号6考察: 掌握市场风险、信用风险、操作风险、法律风险的基本特征和分类方法。(credit spread widening是市场风险，不是信用风险)}{13}{Item.52}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号7考察: 理解尾部风险和结构性变化的关系。（尾部风险是极端事件，结构性变化是系统性风险）}{13}{Item.56}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{题号8考察: 掌握操作风险的定义。（抓住内部流程、人员、系统、培训这些字眼）}{14}{Item.60}\protected@file@percent }
