\contentsline {section}{\numberline {1}考点1：Basic Concepts 基础概念}{3}{}%
\contentsline {subsection}{题号1考察: 考查欧式看涨期权和远期合约利润计算及利润相等时标的资产价格的求解（注意区分期权和远期合约的收益计算公式）}{3}{}%
\contentsline {subsection}{题号2考察: 多头看跌期权收益计算（注意看计算的是payoff还是profit）}{3}{}%
\contentsline {subsection}{题号3考察: 股票股息对股票期权份数和执行价格调整的计算（注意辨析股票股息和股票拆分）}{4}{}%
\contentsline {subsection}{题号4考察: 不同类型期权上下限计算（尤其注意美式看跌期权最小值的计算公式）}{4}{}%
\contentsline {subsection}{题号5考察: 欧洲看涨期权和欧洲看跌期权在给定条件下到期是否行权的判断}{5}{}%
\contentsline {subsection}{题号6考察: 影响欧式看涨期权价值的因素（包括股票拆分、股息变化、利率变动和波动率变化）}{5}{}%
\contentsline {subsection}{题号7考察: 考查影响欧式看涨期权价值的因素，包括股票拆分、股息变化、利率变动和波动率变化。}{6}{}%
\contentsline {subsection}{题号8考察: 美式看涨期权和美式看跌期权价格差异上下限(无股息)}{6}{}%
\contentsline {subsection}{题号9考察: 美式看涨期权和美式看跌期权价格差异上下限（有股息）}{7}{}%
\contentsline {subsection}{题号10考察: 买卖权平价定理（计算看涨期权价格）}{8}{}%
\contentsline {subsection}{题号11考察: 美式和欧式看跌期权最低价格的计算}{8}{}%
\contentsline {subsection}{题号12考察: 美式和欧式看涨期权最低价格计算}{8}{}%
\contentsline {subsection}{题号13考察: 欧式看跌期权上下限的计算}{9}{}%
\contentsline {subsection}{题号14考察: 买卖权平价定理（计算看涨期权价格）}{9}{}%
\contentsline {subsection}{题号15考察: 欧式期权平价公式的变形应用(如何构造复制组合，注意理解正负数含义)}{10}{}%
\contentsline {subsection}{题号16考察: 期权价格上限的计算（辨析欧式和美式看涨、看跌期权价格的上限）}{10}{}%
\contentsline {subsection}{题号17考察: 期权平价公式计算隐含股息率（关键是掌握有股息时的期权平价公式）}{11}{}%
\contentsline {subsection}{题号18考察: 买卖期权平价公式的应用（注意是包含股息的期权平价公式，且需要计算股息的现值）}{11}{}%
\contentsline {subsection}{题号19考察: 股息对期权价值的影响（关键是理解股息对股票价格的影响，以及股票价格变化如何影响不同类型期权的价值）}{12}{}%
\contentsline {section}{\numberline {2}考点2:Trading Strategies 交易策略}{12}{}%
\contentsline {subsection}{题号1考察: 备兑看涨期权头寸(股票多头+看涨期权空头)}{12}{}%
\contentsline {subsection}{题号2考察: 不同期权策略的适用场景(备兑看涨期权略是持有股票同时卖出看涨期权)}{13}{}%
\contentsline {subsection}{题号3考察: 备兑看涨期权、本金保护型票据、领子期权等单期权策略的构造及特点(关注各策略中期权和股票的买卖方向)}{13}{}%
\contentsline {subsection}{题号4考察: 牛市价差期权策略的利润计算(买入行权价较低的看涨期权+卖出行权价较高的看涨期权)}{14}{}%
\contentsline {subsection}{题号5考察: 熊市看跌期权价差策略的利润计算(卖出行权价较低的看跌期权+买入行权价较高的看跌期权)}{14}{}%
\contentsline {subsection}{题号6考察: 蝶式价差策略(判断是否存在套利机会，即判断组合利润是否始终大于0)}{15}{}%
\contentsline {subsection}{题号7考察: 蝶式价差策略的利润计算}{15}{}%
\contentsline {subsection}{题号8考察: 不同期权交易策略在股价波动预期下的应用（宽跨式组合比跨式组合成本低，且在股价大幅波动时都能盈利）}{16}{}%
\contentsline {subsection}{题号9考察: 跨式期权策略的利润计算，关键是牢记计算公式并正确代入数据进行计算(买入相同价格的看涨期权和看跌期权)}{16}{}%
\contentsline {subsection}{题号10考察: 宽跨式期权策略的利润计算(买入不同价格的看涨期权和看跌期权)}{17}{}%
\contentsline {subsection}{题号11考察: 股价大幅波动且方向不明情况下适用的期权策略（跨式/宽跨式期权策略多头，蝶式价差策略空头）}{17}{}%
\contentsline {subsection}{题号12考察: 熊市价差策略构造方式(买入较高执行价格的看涨期权+卖出较低执行价格的看涨期权/买入较高执行价格的看跌期权+卖出较低执行价格的看跌期权)}{18}{}%
\contentsline {subsection}{题号13考察: 蝶式价差期权策略的盈利计算(关键是计算各部分期权的盈利情况，并加总)}{18}{}%
\contentsline {subsection}{题号14考察: 在股价波动预期及方向偏好下适用的期权策略(辨析条式策略和带式策略)}{19}{}%
\contentsline {subsection}{题号15考察: 蝶式价差组合的利润计算（注意各部分期权的份数）}{19}{}%
\contentsline {subsection}{题号16考察: 构造期权组合模拟期货空头头寸（关键是理解期权和期货空头头寸的收益特征）}{20}{}%
\contentsline {subsection}{题号17考察: 蝶式价差期权策略的风险特征（关键是理解蝶式价差策略中期权组合方式对上下行风险的限制作用）}{20}{}%
\contentsline {subsection}{题号18考察: 不同期权策略的收益特征比较（关键是掌握不同期权策略的收益图）}{21}{}%
\contentsline {subsection}{题号19考察: 熊市价差期权策略的识别与盈亏计算（注意辨析熊市价差和牛市价差的构造方法）}{21}{}%
\contentsline {subsection}{题号20考察: 外汇风险管理中远期合约和期权合约的选择（关键是理解汇率变动对远期合约和期权合约收益的影响，以及期权费在决策中的作用）}{22}{}%
\contentsline {section}{\numberline {3}考点3:Exotic Options 奇异期权}{22}{}%
\contentsline {subsection}{题号1考察: 不同类型期权在激励计划中的适用性（亚式期权的特征及其在避免股价操纵方面的优势）}{23}{}%
\contentsline {subsection}{题号2考察: 对各类奇异期权特点及相关组合关系的理解(关键在于准确掌握不同奇异期权的收益特征、定价关系以及与普通期权的差异)}{23}{}%
\contentsline {subsection}{题号3考察: 奇异期权与平值普通期权成本高低的比较(关键在于理解不同奇异期权是否在各种情况下的收益均高于平值普通期权)}{24}{}%
\contentsline {subsection}{题号4考察: 百慕大期权特性(辨析其他期权类型的行权特点)}{24}{}%
\contentsline {subsection}{题号5考察: 向下敲入看涨期权生效条件(关键在于准确掌握其与标的资产价格及障碍水平的关系)}{25}{}%
\contentsline {subsection}{题号6考察: 现金或无价值看跌期权收益特征(关键在于明确其在不同资产价格与执行价格关系下的收益情况)}{25}{}%
\contentsline {subsection}{题号7考察: 亚式期权可动态对冲的原理(关键在于理解其基于平均价格的特性如何影响不确定性)}{26}{}%
\contentsline {subsection}{题号8考察: 不同期权的vega特性(关键在于理解各期权在不同情境下价值与波动率之间的关系)}{27}{}%
\contentsline {subsection}{题号9考察: 向上敲出看涨期权价值为0的条件(关键在于准确理解其敲出机制与股票价格、障碍价格之间的关系)}{27}{}%
\contentsline {subsection}{题号10考察: 将长期期权转化为零成本衍生品的方法（关键在于理解不同操作对期权成本和收益的影响，以及零成本衍生品的实现方式）}{28}{}%
\contentsline {subsection}{题号11考察: 障碍期权与普通期权的关系以及买卖权平价公式的应用（关键是理解障碍期权组合与普通期权价格的关系）}{28}{}%
\contentsline {subsection}{题号12考察: 期权Delta值的特性（关键是理解各类期权在标的资产价格变动时的价值变化规律）}{29}{}%
\contentsline {subsection}{题号13考察: 不同类型障碍期权（向下敲出、向下敲入、向上敲出、向上敲入）在股票价格变动时的价值变化（关键是辨析各类障碍期权的生效条件）}{30}{}%
\contentsline {subsection}{题号14考察: 浮动回望看涨期权和固定回望看涨期权的收益计算（关键是辨析浮动回望期权和固定回望期权的收益计算方式）}{30}{}%
\contentsline {subsection}{题号15考察: 二元期权的收益计算（注意对于asset-or-nothing call/put option，如果股票价格在到期时最终高于/低于行使价，则支付股票的价值，否则不支付任何款项）}{31}{}%
\contentsline {subsection}{题号16考察: 交易所交易期权和场外交易期权的特点对比（关键是准确掌握两种期权在合约风格、期限、交易标的和条款灵活性等方面的差异）}{31}{}%
\contentsline {subsection}{题号17考察: 不同外汇对冲工具的特点和成本效益比较（关键是理解亚式期权、期货合约、互换和远期合约的特点，并根据成本效益原则进行选择）}{32}{}%
\contentsline {subsection}{题号18考察: 不同类型期权的成本比较（关键是理解各类期权的特点和灵活性，灵活性越高成本通常越高）}{32}{}%
\contentsfinish 
