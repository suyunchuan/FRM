\@writefile{toc}{\contentsline {subsection}{题号2考察: 利率互换中的收益计算（关键在于准确计算固定利率差值和浮动利率差值，并比较得出最大联合收益）}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}考点2:Types of Swaps 互换类型}{3}{}\protected@file@percent }
